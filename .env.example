# Токен бота от @BotFather. Для разработки используем тестовый токен, для прода — боевой.
BOT_TOKEN=

# Telegram ID админа (числовой). Узнать у @userinfobot.
ADMIN_ID=

# Username админа без @ (например: shop_admin). Нужен для deep-link «Купить».
ADMIN_USERNAME=

# Адрес БД. Локально — SQLite в файле app.db. В Docker — путь к тому.
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Текст кнопки «📍 О магазине».
# Поддерживается HTML (<b>, <i>, <a href='...'>) и переносы строк (просто новая строка в кавычках).
SHOP_INFO="🏪 <b>Brand Ochki</b>

Магазин очков, кепок, часов и аксессуаров.

🕒 Режим работы:
Пн–Сб: 10:00 — 22:00
Вс: 11:00 — 20:00"

# Текст кнопки «📞 Контакты». Используйте одинарные кавычки внутри HTML-атрибутов.
CONTACTS="📞 Телефон: <a href='tel:+998901234567'>+998 90 123-45-67</a>
💬 Telegram: @shop_admin
📍 Адрес: г. Ташкент, ул. Шахрисабз, 12"
