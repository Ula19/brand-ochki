# --- Telegram ---
# Токен бота от @BotFather. Для разработки — тестовый токен, для прода — боевой.
BOT_TOKEN=

# Telegram ID админа (числовой). Узнать у @userinfobot.
ADMIN_ID=

# Username админа без @ (например: shop_admin). Нужен для deep-link «Купить».
ADMIN_USERNAME=

# --- База данных (PostgreSQL) ---
# Креды читает и контейнер db (создаёт БД при первом старте), и бот через
# DATABASE_URL ниже. Пароль в обоих местах должен совпадать.
POSTGRES_USER=ochki
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ochki

# Адрес БД для приложения и Alembic. В Docker хост — имя сервиса «db».
DATABASE_URL=postgresql+asyncpg://ochki:change_me@db:5432/ochki

# --- Тексты магазина (необязательно) ---
# Можно задать здесь, но удобнее править через админку (📝 Тексты) — там значения
# сохраняются в БД. Поддерживается HTML (<b>, <i>, <a href='...'>) и переносы строк.
SHOP_INFO="🏪 <b>Brand Ochki</b>

Магазин очков, кепок, часов и аксессуаров.

🕒 Режим работы:
Пн–Сб: 10:00 — 22:00
Вс: 11:00 — 20:00"

# Внутри HTML-атрибутов используйте одинарные кавычки.
CONTACTS="📞 Телефон: <a href='tel:+998901234567'>+998 90 123-45-67</a>
💬 Telegram: @shop_admin
📍 Адрес: г. Ташкент, ул. Шахрисабз, 12"
